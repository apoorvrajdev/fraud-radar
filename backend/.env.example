# Fraud Radar backend — example environment configuration.
# Copy to `.env` and edit. All keys are optional; defaults live in
# `app/config.py`.

# Application
APP_ENV=development
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./fraud_radar.db

# API
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated allow-list for the dashboard origin. No wildcards.
CORS_ORIGINS=http://localhost:5173

# ML
MODEL_ARTIFACTS_DIR=./ml/artifacts

# Simulator
SIMULATOR_ENABLED=true
SIMULATOR_TX_PER_SECOND=2
