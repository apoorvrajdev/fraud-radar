# Frontend environment template.
# Copy to `.env.local` and adjust as needed. Only variables prefixed
# with VITE_ are exposed to client code (see Vite docs).

# Base URL of the FastAPI backend, including the version prefix.
# The axios client appends paths like `/stats/overview` to this.
VITE_API_URL=http://localhost:8000/api/v1

# --- Phase 4C demo mode --------------------------------------------------
# Set `VITE_DEMO_MODE=true` to swap the live backend for the bundled
# snapshot under `public/demo-data/`. Used by the public Vercel build;
# leave unset for local development. When enabled, polling is disabled
# and analyst write actions render as visibly-disabled stubs.
#
# `VITE_DEMO_SNAPSHOT_DATE` is rendered verbatim in the demo banner
# and sidebar footer ("snapshot from {DATE}"). Set it to whatever date
# you ran `scripts/export_demo_snapshot.py` on, in any format you like.
#
# VITE_DEMO_MODE=true
# VITE_DEMO_SNAPSHOT_DATE=2026-05-28
